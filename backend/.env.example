# Application Server Port
PORT=5000

# MongoDB Cloud Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/auto_domain_saver?retryWrites=true&w=majority

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq AI API Key (Automatic Fallback)
GROQ_API_KEY=your_groq_api_key_here

# Self-Ping URL to prevent Render free instance cold starts (e.g., https://auto-url-saver.onrender.com)
SELF_PING_URL=https://auto-url-saver.onrender.com

# Allowed Frontend CORS Origin
CORS_ORIGIN=https://urlsaver.sickykumar.in

